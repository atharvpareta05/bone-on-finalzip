# CareLens Backend Configuration
ENVIRONMENT=production
DEBUG=false

# Security & JWT Tokens (Must be a 32+ character random secret in production)
JWT_SECRET_KEY=change_me_to_a_secure_random_hex_key_at_least_32_characters_long
JWT_REFRESH_SECRET_KEY=change_me_to_a_different_secure_random_hex_key_for_refresh
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Persistence & Storage
DATABASE_URL=sqlite:///app_data.sqlite3
UPLOAD_DIR=app_uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Model Artifacts
MODEL_WEIGHTS_PATH=outputs/resnet50_augmented/best_resnet50.pt
DEVICE=auto

# CORS Origins (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
